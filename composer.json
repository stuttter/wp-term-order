{
  "name": "stuttter/wp-term-order",
  "description": "Sort taxonomy terms, your way",
  "homepage": "https://github.com/stuttter/wp-term-order",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4",
    "composer/installers": "^1.0 || ^2.0"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "6.4.*",
    "phpstan/phpstan": "^2.2.13",
    "phpunit/phpunit": "^9.6"
  },
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "John James Jacoby",
      "email": "johnjamesjacoby@me.com"
    }
  ],
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  },
  "scripts": {
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  }
}
